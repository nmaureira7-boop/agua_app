{% extends "base.html" %}

{% block content %}
<div class="container mt-4">
  <h2 class="mb-4">Editar ingreso</h2>

  <!-- Información del ingreso -->
  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <h5 class="card-title">Detalles del ingreso</h5>
      <p><strong>Usuario:</strong> {{ ingreso.nombre }} ({{ ingreso.correo }})</p>
      <p><strong>Dirección:</strong> {{ ingreso.direccion }}</p>
      <p><strong>Fecha:</strong> {{ ingreso.fecha }}</p>
      <p><strong>Consumo:</strong> {{ ingreso.consumo }} m³</p>

      <!-- Mostrar foto si existe -->
      {% if ingreso.url_foto %}
        <div class="mb-3">
          <img src="{{ ingreso.url_foto }}" alt="Foto ingreso" class="img-thumbnail" width="200">
          <div class="mt-2">
            <a href="{{ ingreso.url_foto }}" target="_blank" class="btn btn-sm btn-outline-info">
              <i class="fa-solid fa-eye"></i> Ver en pestaña nueva
            </a>
            <a href="{{ ingreso.url_foto }}" download class="btn btn-sm btn-outline-success">
              <i class="fa-solid fa-download"></i> Descargar
            </a>
          </div>
        </div>
      {% else %}
        <p class="text-muted">Sin foto enviada</p>
      {% endif %}
    </div>
  </div>

  <!-- Formulario de edición -->
  <form method="post" class="card p-4 shadow-sm">
    <!-- Estado de validación -->
    <div class="mb-3">
      <label for="estado" class="form-label">Estado de validación</label>
      <select name="estado" id="estado" class="form-select">
        <option value="pendiente" {% if ingreso.estado_validacion == 'pendiente' %}selected{% endif %}>Pendiente</option>
        <option value="aprobado" {% if ingreso.estado_validacion == 'aprobado' %}selected{% endif %}>Aprobado</option>
        <option value="rechazado" {% if ingreso.estado_validacion == 'rechazado' %}selected{% endif %}>Rechazado</option>
      </select>
    </div>

    <!-- Mensaje al usuario -->
    <div class="mb-3">
      <label for="mensaje_admin" class="form-label">Mensaje al usuario</label>
      <textarea name="mensaje_admin" id="mensaje_admin" class="form-control" rows="3"
        placeholder="Ejemplo: Falta enviar foto para confirmar el pago">{{ ingreso.mensaje_admin }}</textarea>
    </div>

    <!-- Botones -->
    <button type="submit" class="btn btn-primary">
      <i class="fa-solid fa-save me-2"></i> Guardar cambios
    </button>
    <a href="{{ url_for('admin_dashboard') }}" class="btn btn-secondary ms-2">
      <i class="fa-solid fa-arrow-left me-2"></i> Volver al dashboard
    </a>
  </form>
</div>
{% endblock %}
